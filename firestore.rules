rules_version = '2';

// Vikzar Firestore Security Rules — generated at Phase 8B to match
// BACKEND_SPECIFICATION.md §15 (Security Rules Strategy), as revised by
// DECISIONS.md ADR-051 (client-direct writes for workspace/team/onboarding
// state, MVP self-service model). This governs the Flutter Application's
// direct access only — Cloud Functions run with Admin privileges and are
// never subject to these rules (BACKEND_SPECIFICATION.md §15, §0).
//
// NOT DEPLOYED. This file is created per Phase 8B's explicit instruction
// ("Do not deploy. Only create them.") — deploying requires a project
// owner decision and `firebase deploy --only firestore:rules`, run
// deliberately, outside this phase's scope.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data;
    }

    // BACKEND_SPECIFICATION.md §15: "Every rule of the form 'coach of
    // teamId' is implemented as: request.auth.uid in
    // get(.../teams/$(teamId)).data.coachIds."
    // Phase 13 fix: `teamId == null` now short-circuits to `false` rather
    // than calling `teamDoc(null)` (a `get()` on an invalid path, which
    // denies the whole rule) — needed so `devices/{deviceId}`'s
    // pooled/unassigned devices (`assignedTeamId == null`) can be
    // reasoned about explicitly instead of always failing closed by
    // accident.
    function isCoachOfTeam(teamId) {
      return teamId != null && isSignedIn() && request.auth.uid in teamDoc(teamId).coachIds;
    }

    function isMemberOfTeam(teamId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    // ---- organizations/{orgId} ---------------------------------------
    // Read: members of any team under this org. No UI reads this
    // collection yet (Coach Home has no team/org pipeline this phase);
    // approximated via the reader's own denormalized `primaryOrgId`
    // (§1.5), since Rules cannot efficiently reverse-query "any team
    // under this org."
    match /organizations/{orgId} {
      allow read: if isSignedIn() && userDoc(request.auth.uid).primaryOrgId == orgId;
      allow write: if false; // administrative provisioning only
    }

    // ---- teams/{teamId} -----------------------------------------------
    match /teams/{teamId} {
      allow read: if isCoachOfTeam(teamId) || isMemberOfTeam(teamId);

      // Phase 15: team creation and joining (as coach or player) now
      // happen exclusively through `createTeam`/`joinTeamAsCoach`/
      // `joinTeamWithInvite` (Admin SDK, not subject to these rules).
      // The previous self-service `create` (creator names themself sole
      // coach) and `update` (any signed-in user self-adds to `coachIds`
      // using the teamId itself as the "join code") arms are removed —
      // neither ever validated an invite, so any client that learned a
      // teamId could join as co-coach with no server-side check at all.
      allow create: if false;

      // A coach may still update `name`/`ageGroup` directly — this was
      // never the vulnerable path; `coachIds` is no longer client-
      // writable at all.
      allow update: if isCoachOfTeam(teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'ageGroup', 'updatedAt']);

      allow delete: if false;

      // ---- teams/{teamId}/members/{uid} -------------------------------
      match /members/{memberUid} {
        allow read: if isCoachOfTeam(teamId) || isMemberOfTeam(teamId);

        // Phase 15: player self-join is now `joinTeamWithInvite`
        // (invite-code validated server-side, Admin SDK). The previous
        // `isSelf(memberUid)` arm let any signed-in user create their
        // own membership in any team merely by knowing its id — no
        // invite code was ever checked at the rules level. A coach can
        // still manage roster entries directly (add/remove players
        // manually, unrelated to the invite system).
        allow create: if isCoachOfTeam(teamId);
        allow update: if isCoachOfTeam(teamId);
        allow delete: if isCoachOfTeam(teamId);
      }

      // ---- teams/{teamId}/liveMonitoring/{playerId} -------------------
      match /liveMonitoring/{playerId} {
        allow read: if isCoachOfTeam(teamId) || isSelf(playerId);
        allow write: if false; // Cloud Function fan-out only
      }
    }

    // ---- users/{uid} ---------------------------------------------------
    match /users/{uid} {
      // Self; a coach of the team this user's Player workspace belongs
      // to (roster/profile visibility, §5).
      allow read: if isSelf(uid) ||
        (isSignedIn() &&
          resource.data.workspaces.player != null &&
          resource.data.workspaces.player.teamId != null &&
          isCoachOfTeam(resource.data.workspaces.player.teamId));

      // Phase 13 fix: previously `if isSelf(uid)` with no field allowlist
      // at all — a signing-up client could self-write `careerStats`
      // (Cloud-Function-only, per §1.5) or an arbitrary `primaryOrgId`
      // at account creation. Now uses the same allowlist as `update`
      // below, plus requires the embedded `uid` field to match the
      // document ID.
      allow create: if isSelf(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl', 'fcmTokens',
          'workspaces', 'defaultWorkspace', 'playerProfile', 'coachProfile',
          'status', 'createdAt', 'updatedAt',
        ]);

      // Self-scoped writes only. `careerStats` and `primaryOrgId` remain
      // denied — both are Cloud-Function-only (§1.5).
      //
      // Phase 15 hardening: once a workspace exists, its contents are
      // frozen against further client edits — a first-time grant (null
      // -> a value) is still allowed, which is all onboarding
      // completion ever needs, but a client can no longer change
      // `workspaces.player.teamId` or `workspaces.coach.teamIds` after
      // the fact. Real access was never actually gated on this
      // denormalized field (`isCoachOfTeam`/`isMemberOfTeam` re-derive
      // from `teams`/`members` directly), so this was defense-in-depth
      // rather than the exploitable hole — but it's cheap to close, and
      // means `workspaces` can never silently drift from what
      // `joinTeamWithInvite`/`joinTeamAsCoach` actually granted.
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'email', 'displayName', 'avatarUrl', 'fcmTokens',
          'workspaces', 'defaultWorkspace', 'playerProfile', 'coachProfile',
          'status', 'createdAt', 'updatedAt',
        ]) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['careerStats', 'primaryOrgId']) &&
        (
          !('workspaces' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (
            resource.data.get('workspaces', {}).get('player', null) == null ||
            request.resource.data.get('workspaces', {}).get('player', null) == resource.data.get('workspaces', {}).get('player', null)
          ) &&
          (
            resource.data.get('workspaces', {}).get('coach', null) == null ||
            request.resource.data.get('workspaces', {}).get('coach', null) == resource.data.get('workspaces', {}).get('coach', null)
          )
        );

      allow delete: if false;

      // ---- users/{uid}/notifications/{notificationId} -----------------
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create: if false; // Cloud Function only
        allow update: if isSelf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if false;
      }

      // ---- users/{uid}/razDailyBriefs/{docId} ------------------------
      // RAZ's context-hash-keyed cached brief — Cloud-Function-only in
      // both directions, matching `_rateLimits`: Flutter always gets
      // the brief through `razDailyBrief`'s return value, never by
      // reading this collection directly, so there is no client read
      // path to grant here at all.
      match /razDailyBriefs/{docId} {
        allow read, write: if false;
      }

      // ---- users/{uid}/razMemories/{topic} ----------------------------
      // RAZ's persistent, structured memory (one document per topic) —
      // Cloud-Function-only in both directions, same reasoning as
      // `razDailyBriefs` above. Flutter never reads memory directly; it
      // only ever sees memory's effect through a brief/reply that used
      // it.
      match /razMemories/{topic} {
        allow read, write: if false;
      }
    }

    // ---- teamInvites/{code} ---------------------------------------------
    // Added Phase 15. Maps a random, unguessable invite code to a
    // teamId. Never client-readable or client-writable — `createTeam`/
    // `createTeamInvite` mint codes and `joinTeamWithInvite` resolves
    // them, all via the Admin SDK, so a client can never enumerate valid
    // codes or bypass redemption by reading/writing this collection
    // directly. Document id doubling as the code itself (rather than a
    // `code` field looked up by query) is what makes "no `list`
    // permission" sufficient to prevent enumeration — a client would
    // need to already know the exact code to even attempt a read, and
    // this rule denies that read anyway.
    match /teamInvites/{code} {
      allow read, write: if false;
    }

    // ---- coachRequests/{requestId} -------------------------------------
    // Added Phase 8B (§1.12). Creation only — no admin-approval flow in
    // this codebase yet (ADR-049/ADR-051).
    match /coachRequests/{requestId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if false;
      allow delete: if false;
    }

    // ---- devices/{deviceId} ---------------------------------------------
    match /devices/{deviceId} {
      allow read: if isSignedIn() &&
        (resource.data.ownerId == request.auth.uid || isCoachOfTeam(resource.data.assignedTeamId));
      // Phase 13 fix: previously only checked the coach was authorized
      // for the device's *current* team, so a coach of Team A could
      // reassign a device into Team B, which they don't coach. Now
      // requires authorization on both ends: the device's current team
      // (or it's unassigned/pooled, per §7 — any signed-in coach may
      // claim a pooled device) and the target team (or it's being
      // released back to the pool).
      allow update: if isSignedIn() &&
        (resource.data.assignedTeamId == null || isCoachOfTeam(resource.data.assignedTeamId)) &&
        (request.resource.data.assignedTeamId == null || isCoachOfTeam(request.resource.data.assignedTeamId)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'assignedTeamId', 'status', 'mountLocation', 'laterality', 'updatedAt']);
      allow create: if false; // no device-provisioning UI this phase
      allow delete: if false;
    }

    // ---- sessions/{sessionId} (+ live/current) ---------------------------
    match /sessions/{sessionId} {
      allow read: if isSignedIn() &&
        (resource.data.playerId == request.auth.uid || isCoachOfTeam(resource.data.teamId));
      allow write: if false; // Cloud Function only

      match /live/current {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/sessions/$(sessionId)).data.playerId == request.auth.uid ||
           isCoachOfTeam(get(/databases/$(database)/documents/sessions/$(sessionId)).data.teamId));
        allow write: if false; // Cloud Function only
      }
    }

    // ---- plannedSessions/{plannedSessionId} -------------------------------
    // Added Phase 13 (§5's Sessions architecture) — a coach-scheduled
    // training/match slot, distinct from the laptop-authored
    // `sessions/{sessionId}` (§1.8), which represents a real capture and
    // remains laptop-only. Created exclusively by `createPlannedSession`
    // (a Coach-callable Cloud Function, not the ingestion principal) —
    // the frontend "Create Session" UI never writes here directly.
    match /plannedSessions/{plannedSessionId} {
      allow read: if isSignedIn() &&
        (isCoachOfTeam(resource.data.teamId) || isMemberOfTeam(resource.data.teamId));
      allow write: if false; // Cloud Function only
    }

    // ---- _rateLimits/{principalUid} ----------------------------------------
    // Added Phase 13 (§10) — per-principal call counters used by
    // `ingestLiveTick`/`createPlannedSession`. Never client-readable or
    // client-writable; exists purely for Cloud Functions' own Admin-SDK
    // bookkeeping.
    match /_rateLimits/{principalUid} {
      allow read, write: if false;
    }

    // ---- _processedEvents/{eventId} ----------------------------------------
    // Added Phase 19.5 — Cloud Firestore trigger idempotency markers
    // (`lib/idempotency.ts`'s `withEventIdempotency`), guarding trigger
    // side effects that aren't naturally idempotent against Firestore's
    // at-least-once delivery. Never client-readable or client-writable,
    // same pattern as `_rateLimits`.
    match /_processedEvents/{eventId} {
      allow read, write: if false;
    }

    // ---- alerts/{alertId} -------------------------------------------------
    match /alerts/{alertId} {
      allow read: if isSignedIn() &&
        (resource.data.playerId == request.auth.uid || isCoachOfTeam(resource.data.teamId));
      allow create: if false; // Cloud Function only
      // Phase 13 hardening: `acknowledgedBy` must equal the caller — a
      // coach could previously stamp a different coach's uid as the
      // acknowledger (data-integrity gap, not an access-control one,
      // since the write itself was already gated to coaches of this
      // team).
      allow update: if isCoachOfTeam(resource.data.teamId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledged', 'acknowledgedBy', 'acknowledgedAt']) &&
        (!('acknowledgedBy' in request.resource.data) || request.resource.data.acknowledgedBy == request.auth.uid);
      allow delete: if false;
    }

    // ---- reports/{reportId} ------------------------------------------------
    match /reports/{reportId} {
      allow read: if isSignedIn() &&
        (resource.data.playerId == request.auth.uid || isCoachOfTeam(resource.data.teamId));
      allow write: if false; // Cloud Function only
    }
  }
}
